# Copy this file to ".env.local" (same folder) and put YOUR key in it.
# .env.local is git-ignored, so the key stays on your machine.
# Restart the dev server after creating/changing it.
#
# ANTHROPIC_API_KEY has no VITE_ prefix on purpose: the dev/preview server's
# /api/tutor proxy attaches it server-side, so it is never bundled into the app.
# Get a key at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional — pick the tutor model (default is claude-haiku-4-5):
# VITE_TUTOR_MODEL=claude-haiku-4-5
